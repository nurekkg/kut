# Локальная разработка. Значения ниже — плейсхолдеры, не секреты.
# docker-compose.yml работает и без .env (те же значения заданы как defaults);
# для любого общего окружения скопируйте в .env и замените ВСЕ значения.
# Пароли не должны содержать символы @ : / # (они попадают в DATABASE_URL).

# --- приложение ---
APP_ENV=development

# --- порты на хосте (все публикуются только на 127.0.0.1) ---
API_PORT=8000
WEB_PORT=3100
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL ---
# POSTGRES_USER — суперпользователь кластера: им работает только сервис db-bootstrap, приложение — никогда.
POSTGRES_DB=kut
POSTGRES_USER=kut
POSTGRES_PASSWORD=kut_dev_password

# Логины приложения (ADR-001 §1). db-bootstrap создаёт роли и выставляет эти пароли при каждом запуске.
# kut_owner — миграции; kut_app — API (внутренний трафик); kut_portal — API (внешние роли, только SELECT);
# kut_worker — Celery (BYPASSRLS). С APP_ENV=production значения с «dev_password» bootstrap отвергает.
KUT_OWNER_PASSWORD=kut_owner_dev_password
KUT_APP_PASSWORD=kut_app_dev_password
KUT_PORTAL_PASSWORD=kut_portal_dev_password
KUT_WORKER_PASSWORD=kut_worker_dev_password
# 1 — создать <POSTGRES_DB>_test для тестов (dev и CI); в боевом окружении не задавать.
KUT_BOOTSTRAP_TEST_DB=1

# --- Аутентификация (ADR-001 §2) ---
# Ключи подписи JWT (Ed25519, seed из 32 байт в base64url): «kid:ключ[,kid:ключ]». Подписывает
# JWT_ACTIVE_KID, проверяются все перечисленные: для ротации добавьте новый ключ, переключите
# JWT_ACTIVE_KID, через время жизни access-токена (10 минут) уберите старый.
# kid с префиксом «dev» — примеры для разработки: с APP_ENV=production API с ними не запустится.
# Новый ключ: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
JWT_PRIVATE_KEYS=dev-1:GLp4ipa8ygJMpz5w-usHPDsFMC-QZyMJLNMKBU33drQ
JWT_ACTIVE_KID=dev-1
# Ключи AES-256-GCM для секретов TOTP (32 байта в base64url): «key_id:ключ[,key_id:ключ]».
TOTP_ENCRYPTION_KEYS=dev-1:J4WKMm-ZdEWech8b3xRh2jNaRBI8NTBQQE46PaqMRGc
TOTP_ACTIVE_KEY_ID=dev-1
# Доверять последнему адресу в X-Forwarded-For (нужно лимиту попыток по IP, когда API за прокси).
# Не задано: включено только при APP_ENV=development (API за прокси web), в test и production выключено.
# В production включайте явно и только если перед API стоит доверенный прокси, который сам дописывает
# заголовок; иначе клиент подменит свой адрес и обойдёт лимит.
# TRUST_FORWARDED_FOR=true
# Только для разработки (сервис dev-seed, APP_ENV=development): общий пароль демо-пользователей и
# секрет TOTP владельца и финансового директора (base32).
DEV_SEED_PASSWORD=dev_password_change_me
DEV_SEED_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Периодичность задач обслуживания (сервис beat), секунды: очистка просроченных токенов и ключей
# идемпотентности; создание партиций audit_log вперёд.
MAINTENANCE_PURGE_SECONDS=3600
MAINTENANCE_PARTITIONS_SECONDS=86400

# --- S3 / MinIO ---
S3_BUCKET=kut-files
S3_REGION=us-east-1
S3_ACCESS_KEY=kut_dev_access
S3_SECRET_KEY=kut_dev_secret_key
