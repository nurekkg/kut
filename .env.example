# Локальная разработка. Значения ниже — плейсхолдеры, не секреты.
# docker-compose.yml работает и без .env (те же значения заданы как defaults);
# для любого общего окружения скопируйте в .env и замените ВСЕ значения.
# Пароли не должны содержать символы @ : / # (они попадают в DATABASE_URL).

# --- приложение ---
APP_ENV=development

# --- порты на хосте (все публикуются только на 127.0.0.1) ---
API_PORT=8000
WEB_PORT=3100
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL ---
# POSTGRES_USER — суперпользователь кластера: им работает только сервис db-bootstrap, приложение — никогда.
POSTGRES_DB=kut
POSTGRES_USER=kut
POSTGRES_PASSWORD=kut_dev_password

# Логины приложения (ADR-001 §1). db-bootstrap создаёт роли и выставляет эти пароли при каждом запуске.
# kut_owner — миграции; kut_app — API (внутренний трафик); kut_portal — API (внешние роли, только SELECT);
# kut_worker — Celery (BYPASSRLS). С APP_ENV=production значения с «dev_password» bootstrap отвергает.
KUT_OWNER_PASSWORD=kut_owner_dev_password
KUT_APP_PASSWORD=kut_app_dev_password
KUT_PORTAL_PASSWORD=kut_portal_dev_password
KUT_WORKER_PASSWORD=kut_worker_dev_password
# 1 — создать <POSTGRES_DB>_test для тестов (dev и CI); в боевом окружении не задавать.
KUT_BOOTSTRAP_TEST_DB=1

# --- S3 / MinIO ---
S3_BUCKET=kut-files
S3_REGION=us-east-1
S3_ACCESS_KEY=kut_dev_access
S3_SECRET_KEY=kut_dev_secret_key
