# хуки git должны быть с LF: при checkout на Windows (autocrlf) shebang иначе ломается
scripts/git-hooks/* text eol=lf
*.py text=auto eol=lf
*.ts text=auto eol=lf
*.tsx text=auto eol=lf
*.js text=auto eol=lf
*.json text=auto eol=lf
*.yaml text=auto eol=lf
*.yml text=auto eol=lf
*.md text=auto eol=lf
*.sql text=auto eol=lf
*.toml text=auto eol=lf
*.css text=auto eol=lf
